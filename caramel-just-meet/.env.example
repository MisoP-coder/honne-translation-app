# ここに書いた値はビルドのときにアプリへ埋め込まれ、ブラウザから見えます（秘密の鍵は入れないこと）。
# Vercel では Project Settings > Environment Variables に同じ名前で登録します。

# --- 世界ランキング（Supabase）-------------------------------------------
# Supabase ダッシュボード > Project Settings > API から取得します。
# 空のままだと、ランキングは「サンプル表示」になります。
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- 公開 URL（任意）-------------------------------------------------------
# 独自ドメインを使うときだけ設定します。Vercel の標準の URL なら自動で入るので不要です。
# EXPO_PUBLIC_SITE_URL=https://caramel.example.com
