# --- Supabase -------------------------------------------------------------
# Supabase ダッシュボード > Project Settings > API から取得します。
# ブラウザにも公開される値です(anon key は RLS 前提の公開鍵)。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Claude API -----------------------------------------------------------
# サーバー側でのみ使用します。NEXT_PUBLIC_ を付けないこと(付けるとブラウザに漏れます)。
# https://console.anthropic.com/ で発行します。
ANTHROPIC_API_KEY=sk-ant-...
